{
  "name": "ares-01",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:engineering": "node scripts/test-engine.mjs",
    "test:models": "playwright test tests/models.spec.ts",
    "assets:portraits": "node scripts/generate-portraits.mjs",
    "test:preparation": "node scripts/test-preparation.mjs",
    "test:mission-budget": "node scripts/test-mission-budget.mjs",
    "test:model-loading": "node scripts/test-model-loading.mjs",
    "test:mission-energy": "node scripts/test-mission-energy.mjs",
    "test:campaign": "node scripts/test-campaign.mjs && node scripts/test-campaign-boundaries.mjs",
    "test:campaign-ui": "npm run build && playwright test --config playwright.missions.config.ts",
    "test:tutorial": "node scripts/test-tutorial.mjs",
    "test:tutorial-ui": "npm run build && playwright test --config playwright.tutorial.config.ts",
    "test:presentation": "playwright test tests/presentation.spec.ts",
    "test:mobility": "node scripts/test-mobility.mjs",
    "test:mobility-ui": "npm run build && playwright test --config playwright.mobility.config.ts",
    "test:expedition": "node scripts/test-expedition.mjs",
    "test:expedition-ui": "npm run build && playwright test --config playwright.expedition.config.ts",
    "test:instruments-ui": "npm run build && playwright test --config playwright.instruments.config.ts"
  },
  "dependencies": {
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@vitejs/plugin-react": "latest",
    "lucide-react": "^1.73.0",
    "react": "latest",
    "react-dom": "latest",
    "three": "^0.187.0",
    "typescript": "latest",
    "vite": "latest",
    "zustand": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0"
  }
}

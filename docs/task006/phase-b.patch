+/** Credit wording supported by the existing asset audit; this is not rights clearance. */
+export default function ProjectCredits() {
+  return <div className="project-credits">
+    <p><strong>Perseverance rover model.</strong> Incorporates NASA/JPL-Caltech content matching the official Mars Perseverance Rover 3D model. Used in an independent educational game. The local mesh is adapted; its acquisition and editing history remain under review. <a href="https://science.nasa.gov/resource/mars-perseverance-rover-3d-model/" target="_blank" rel="noreferrer">NASA source model ↗</a></p>
+    <p>ARES-01 is an independent project created for the NASA Space Apps Challenge. It is not an official NASA product and is not endorsed by NASA or JPL.</p>
+  </div>;
+}

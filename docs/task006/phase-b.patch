+import { ArrowUpRight, ChevronDown } from 'lucide-react';
+import ProjectCredits from './ProjectCredits';
+import './welcome.css';
+
+export default function WelcomeScreen({ onEnter }: { onEnter: () => void }) {
+  return <section className="welcome-screen" aria-labelledby="welcome-title">
+    <header className="welcome-masthead"><span className="welcome-emblem" aria-hidden="true">A</span><span>ASTROCREW<small>A mission design game</small></span></header>
+    <div className="welcome-mission-copy">
+      <p className="welcome-kicker"><span aria-hidden="true" /> MARS / JEZERO CRATER</p>
+      <h1 id="welcome-title" aria-label="ARES-01">ARES<span>—01</span></h1>
+      <p className="welcome-lead">Build the mission.<br />Bring the science home.</p>
+      <p className="welcome-description">Choose your crew role. Prepare a Perseverance payload. Then take the rover into the Martian landscape.</p>
+      <button className="welcome-enter" onClick={onEnter}><span>ENTER MISSION CONTROL</span><ArrowUpRight size={23} aria-hidden="true" /></button>
+      <p className="welcome-team">Six crew seats <span aria-hidden="true">/</span> One mission</p>
+      <details className="welcome-notes">
+        <summary>Sources &amp; project notes <ChevronDown size={16} aria-hidden="true" /></summary>
+        <div className="welcome-notes-content">
+          <p>On Mars, use WASD or the arrow keys to drive, Space to brake and E to scan. Return collected observations with Uplink before ending the mission.</p>
+          <ProjectCredits />
+        </div>
+      </details>
+    </div>
+    <div className="welcome-world-note"><span className="welcome-cross" aria-hidden="true">+</span><p>PERSEVERANCE<small>Drag the landscape to orbit · Scroll to zoom</small></p></div>
+    <footer className="welcome-footer"><span>ARES-01 / ASTROCREW</span><span>MISSION PREPARATION → SURFACE EXPLORATION</span></footer>
+  </section>;
+}

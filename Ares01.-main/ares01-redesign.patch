+.desk-open-prompt i { width: 7px; height: 7px; border-radius: 50%; background: var(--archive-amber); }
+.desk-open-prompt strong { display: flex; align-items: center; gap: 12px; font: 700 clamp(12px, 1.4vw, 20px)/1.5 var(--archive-display); letter-spacing: -.02em; }
+.desk-open-prompt small { color: #9cd3d3; font: 400 11px/1.5 var(--mono); }
+.desk-mug { position: absolute; top: 16%; left: 5%; width: 74px; height: 86px; background: linear-gradient(90deg, #1b202b, #303543); border: 6px solid #171c28; box-shadow: 9px 16px 20px #0006; text-align: center; color: #c1a582; transform: rotate(3deg); }
+.desk-mug::after { content: ''; position: absolute; right: -25px; top: 15px; height: 44px; width: 22px; border: 7px solid #292f3c; border-left: 0; border-radius: 0 10px 10px 0; }
+.desk-mug > span { display: block; font: 700 28px/1.6 var(--archive-display); }
+.desk-mug small { font-size: 7px; letter-spacing: .04em; }
+.desk-pen { position: absolute; bottom: 8%; left: 5%; width: 120px; height: 8px; background: linear-gradient(90deg, #67c9cf 0 5%, #aeb2b8 5% 70%, #333b4c 70%); border: 1px solid #ffffff22; border-radius: 50% 4px 4px 50%; transform: rotate(35deg); box-shadow: 0 8px 15px #0007; }
+.desk-cartridge { position: absolute; right: 3%; top: 22%; width: 112px; padding: 14px 10px; background: linear-gradient(110deg, #303746, #1d2330); border: 1px solid #ffffff1a; box-shadow: 8px 14px 20px #0004; transform: rotate(2deg); display: grid; gap: 18px; }
+.desk-cartridge > span { font-size: 7px; color: #c9d4de; letter-spacing: .05em; }
+.desk-cartridge > div { display: flex; gap: 4px; padding: 10px 5px; background: #090e19; }
+.desk-cartridge i { width: 18px; height: 12px; background: #509196; }
+.desk-cartridge i:nth-child(3) { background: #62c9cf; }
+.desk-cartridge strong { color: #ade0dc; font-size: 18px; }
+.desk-cartridge strong small { font-size: 8px; }
+.desk-footer { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 14px; background: #1c202c; border: 1px solid #ffffff05; padding: 17px 20px; color: #c5c9d4; font-size: 10px; letter-spacing: .07em; }
+.desk-footer > span:first-child { display: flex; align-items: center; gap: 10px; color: #b8dfde; }
+.desk-footer > span:last-child { color: var(--archive-amber); }
